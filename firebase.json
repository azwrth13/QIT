{
  "apphosting": [
    {
      "backendId": "qit",
      "rootDir": "/",
      "ignore": ["node_modules", ".git", ".next", "firebase-debug.log"]
    }
  ],
  "hosting": {
    "site": "qitgames",
    "public": "hosting",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "**",
        "run": { "serviceId": "qit", "region": "us-central1" }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": { "port": 8080 }
  }
}
