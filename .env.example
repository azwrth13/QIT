STEAM_API_KEY="replace-with-steam-web-api-key"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Local Firestore emulator (use firebase emulators:start --only firestore)
