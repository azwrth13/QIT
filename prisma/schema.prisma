// prisma/schema.prisma

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int     @id @default(autoincrement())
  steamId    String  @unique
  profileUrl String
  games      Game[]
}

model Game {
  id              Int     @id @default(autoincrement())
  appid           Int
  name            String
  img_icon_url    String
  playtime_forever Int
  userId          Int
  user            User    @relation(fields: [userId], references: [id])

  @@unique([appid, userId])
}
