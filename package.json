{
  "name": "qit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.ts,.mts,.tsx --ignore-pattern .next --ignore-pattern next-env.d.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/client-ip.test.ts tests/routes.test.ts tests/security.test.ts tests/qit-route-guards.test.ts && node --experimental-strip-types --test tests/library.test.mjs",
    "test:firestore": "firebase emulators:exec --only firestore 'npx vitest run tests/firestore.test.ts'"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "iron-session": "^9.0.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
